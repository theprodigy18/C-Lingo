# Database
DB_HOST=your_host
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_password
DB_SSLMODE=require

# Sandbox
SANDBOX_IMAGE=c-lingo-sandbox:latest
SANDBOX_TIMEOUT=30

# Worker
POLL_INTERVAL=2.0
BATCH_SIZE=10
NUM_WORKERS=4

# Execution Limits
MAX_CPU_TIME=2000
MAX_WALL_TIME=5000
MAX_MEMORY=262144
MAX_OUTPUT_SIZE=1048576